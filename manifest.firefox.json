{
  "manifest_version": 3,
  "name": "Prompt Pile",
  "version": "1.0",
  "description": "A web extension for storing and organizing AI prompts.",
  "icons": {
    "32": "icons/logo_web_32.png",
    "128": "icons/logo_web_128.png"
  },
  "action": { "default_title": "Open Prompt Pile" },
  "sidebar_action": {
    "default_title": "Prompt Pile",
    "default_panel": "popup.html"
  },
  "permissions": ["downloads", "storage", "contextMenus", "clipboardWrite"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": { "id": "prompt-pile@yourdomain.com" }
  }
}
