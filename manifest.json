{
    "manifest_version": 3,
    "name": "Prompt Pile",
    "version": "1.0",
    "description": "A web extension for storing and organizing AI prompts.",
    
    "icons": {
        "16": "icons/logo_web_16.png",
        "24": "icons/logo_web_24.png",
        "32": "icons/logo_web_32.png",
        "48": "icons/logo_web_48.png",
        "128": "icons/logo_web_128.png",
        "512": "icons/logo_web_512.png",
        "1024": "icons/logo_web_1024.png"
    },
    
    "action": {
        "default_title": "Open Prompt Pile"
    },

    "side_panel": {
        "default_path": "popup.html"
    },

    "sidebar_action": {
        "default_title": "Prompt Pile",
        "default_panel": "popup.html",
        "default_icon": "icons/logo_web_16.png"
    },
    
    "permissions": [
        "downloads",
        "storage",
        "sidePanel",
        "contextMenus",
        "clipboardWrite"
    ],

    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "prompt-pile@yourdomain.com"
        }
    }
}