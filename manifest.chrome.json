{
  "manifest_version": 3,
  "name": "Prompt Pile",
  "version": "1.0",
  "description": "A web extension for storing and organizing AI prompts.",
  "icons": {
    "32": "icons/logo_web_32.png",
    "128": "icons/logo_web_128.png"
  },
  "action": { "default_title": "Open Prompt Pile" },
  "side_panel": { "default_path": "popup.html" },
  "permissions": [
    "downloads",
    "storage",
    "sidePanel",
    "contextMenus",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
